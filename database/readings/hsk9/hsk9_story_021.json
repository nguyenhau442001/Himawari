  "quiz": [
    {
      "id": "q1",
      "question_vi": "Khẩu hiệu nổi tiếng 'Trở về với chính bản thân sự vật' của Husserl đòi hỏi điều gì?",
      "options_vi": [
        "Quay về với vật chất tiền bạc",
        "Loại bỏ mọi định kiến lý thuyết trừu tượng và giả định giáo điều để quay về với trải nghiệm trực quan sống động của ý thức",
        "Bỏ qua mọi suy nghĩ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 面向事情本身的号召，吹响了现象学破除实证主义偏见的号角."
    },
    {
      "id": "q2",
      "question_vi": "Khái niệm 'Tính ý hướng' (Intentionality) trong hiện tượng học khẳng định bản chất nào của ý thức?",
      "options_vi": [
        "Ý thức hoàn toàn độc lập cô lập",
        "Mọi ý thức luôn luôn hướng về một đối tượng nào đó (ý thức là ý thức về cái gì đó), không có ý thức trống rỗng",
        "Ý thức là vật chất cơ học"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 意向性理论深刻指出，一切意识从根本上说皆是指向某物的意识."
    },
    {
      "id": "q3",
      "question_vi": "Theo Husserl, cội nguồn nền tảng nâng đỡ mọi lý thuyết khoa học thực chứng là gì?",
      "options_vi": [
        "Các công thức toán học trừu tượng",
        "Thế giới sống nguyên sơ (Lebenswelt) với những trải nghiệm tri giác sinh động của con người",
        "Máy móc trong phòng thí nghiệm"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 生活世界乃是所有严密科学概念赖以奠基的不可替代的原初母体."
    }
  ]
