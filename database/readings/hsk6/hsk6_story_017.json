  "quiz": [
    {
      "id": "q1",
      "question_vi": "Vị trí và ý nghĩa của cổ cầm trong đời sống văn nhân cổ đại là gì?",
      "options_vi": [
        "Dùng để hòa tấu ngoài chợ",
        "Đứng đầu tứ nghệ, là nhạc cụ tao nhã giúp rèn luyện khí tiết và đối thoại nội tâm",
        "Đồ chơi của trẻ con"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 位列琴棋书画四艺之首，被视作砥砺操守、抒发幽思的雅乐圣器."
    },
    {
      "id": "q2",
      "question_vi": "Mục đích cốt lõi của người gảy cổ cầm (抚琴) là gì?",
      "options_vi": [
        "Kiếm tiền bán vé",
        "Không nhằm mua vui thính giả mà để giao cảm với non sông và độc thoại tâm hồn với thánh hiền",
        "Làm ồn xung quanh"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 并非为了取悦听众，而是与山川明月共鸣、与先贤圣哲进行心灵独白."
    },
    {
      "id": "q3",
      "question_vi": "Khúc cầm 'Cao Sơn Lưu Thủy' gửi gắm phẩm chất gì của bậc trí thức xưa?",
      "options_vi": [
        "Tính tham lam danh vọng",
        "Khí phách thà gãy không cong, trong sạch hòa nhã và nhân cách độc lập",
        "Sự phục tùng quyền lực vô điều kiện"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 清正和雅与傲骨铮铮，宁折不弯的精神品格与独立人格."
