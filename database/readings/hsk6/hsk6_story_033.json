  "quiz": [
    {
      "id": "q1",
      "question_vi": "Ứng dụng y học đột phá nhất của giao diện não - máy là gì?",
      "options_vi": [
        "Chơi trò chơi điện tử",
        "Giúp bệnh nhân bại liệt dùng ý nghĩ điều khiển chi giả và bệnh nhân ALS giao tiếp với thế giới",
        "Xóa bỏ việc ngủ nghỉ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 为高位截瘫患者通过意念操控机械臂，为渐冻症患者重获对话能力点亮希望之光."
    },
    {
      "id": "q2",
      "question_vi": "Mối lo ngại đạo đức lớn nhất đối với việc phát triển công nghệ thần kinh sâu là gì?",
      "options_vi": [
        "Tốn quá nhiều pin",
        "Nguy cơ thao túng cảm xúc, can thiệp trí nhớ và xâm phạm quyền riêng tư tư tưởng",
        "Làm mất sóng điện thoại"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 若被用于非医疗目的的情绪操纵、记忆干预乃至隐私入侵，将引发空前激烈的伦理诘问."
    },
    {
      "id": "q3",
      "question_vi": "Lằn ranh đỏ để công nghệ phát triển lành mạnh vì nhân loại là gì?",
      "options_vi": [
        "Không cần bất kỳ sự quản lý nào",
        "Buộc dây cương đạo đức lý tính cho công nghệ để tránh tha hóa bản sắc con người",
        "Ngừng toàn bộ nghiên cứu y khoa"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối có viết: 给科技插上理性的道德缰绳，是保障科技造福人类而不是异化人类的根本底线."
    }
  ]
