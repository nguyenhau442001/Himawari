  "quiz": [
    {
      "id": "q1",
      "question_vi": "Nguyên nhân khiến mô hình lương hưu 'thu tới đâu chi tới đó' (Pay-as-you-go) gặp khủng hoảng là gì?",
      "options_vi": [
        "Số lượng thanh niên sinh ra quá nhiều",
        "Tỷ lệ sinh giảm sâu khiến người lao động đóng phí ít đi trong khi số người già nhận lương hưu tăng vọt",
        "Tiền tệ không còn lưu hành"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 少子化与老龄化并行的现实，使现收现付制养老金面临世代间财务偿付危机."
    },
    {
      "id": "q2",
      "question_vi": "Giải pháp toàn diện để cân bằng cán cân dân số và an sinh xã hội bao gồm những gì?",
      "options_vi": [
        "Phạt nặng người sinh con",
        "Lộ trình lùi tuổi hưu hợp lý, hỗ trợ giảm chi phí nuôi dạy con và phát triển kinh tế bạc (silver economy)",
        "Cắt giảm hoàn toàn tiền hưu trí"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 稳妥推行延迟法定退休年龄，建立健全生育支持政策体系，大力发展银发经济."
    },
    {
      "id": "q3",
      "question_vi": "Mục tiêu nhân văn trong việc phát huy vai trò của người cao tuổi hiện đại là gì?",
      "options_vi": [
        "Cách ly người già khỏi đời sống",
        "Chuyển hóa từ số lượng sang chất lượng nhân lực, tạo điều kiện để người cao tuổi tiếp tục cống hiến kinh nghiệm quý",
        "Bắt người già làm công việc nặng nhọc"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 让健康老年人群体继续发挥经验智库与社会参与价值."
    }
