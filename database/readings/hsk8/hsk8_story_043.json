  "quiz": [
    {
      "id": "q1",
      "question_vi": "Thuật toán Shor (Shor's Algorithm) trên máy tính lượng tử có khả năng phá hủy điều gì?",
      "options_vi": [
        "Phá hủy các linh kiện phần cứng",
        "Bẻ gãy hoàn toàn các hệ thống mã hóa khóa công khai RSA và ECC vốn bảo vệ giao dịch ngân hàng và internet hiện nay",
        "Xóa sạch bộ nhớ USB"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 秀尔算法能在数小时内轻松破解基于大整数分解的传统RSA与ECC加密体系."
    },
    {
      "id": "q2",
      "question_vi": "Chiến thuật 'Thu thập trước, giải mã sau' (Harvest Now, Decrypt Later) của tin tặc là gì?",
      "options_vi": [
        "Chờ máy tính hạ giá mới mua",
        "Đánh cắp và lưu trữ sẵn các dữ liệu mật đã mã hóa hiện nay, đợi khi máy tính lượng tử hoàn thiện sẽ đem ra giải mã",
        "Xóa dữ liệu của nạn nhân"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 窃听并储备海量涉密数据以待量子霸权到来时彻底解密."
    },
    {
      "id": "q3",
      "question_vi": "Hướng đi toán học nào được công nhận để xây dựng chuẩn mật mã hậu lượng tử (PQC) an toàn?",
      "options_vi": [
        "Tiếp tục dùng mật khẩu ngắn",
        "Mật mã học dựa trên mạng tinh thể (Lattice-based cryptography) có độ phức tạp kháng lượng tử",
        "Bỏ qua việc mã hóa"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 基于格密码学等复杂数学难题的后量子密码学（PQC）标准正在全面替换."
    }
  ]
