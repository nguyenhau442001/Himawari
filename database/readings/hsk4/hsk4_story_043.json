  "quiz": [
    {
      "id": "q1",
      "question_vi": "Xu hướng tiến bộ trong giáo dục gia đình hiện đại là gì?",
      "options_vi": [
        "Cha mẹ luôn áp đặt mệnh lệnh tuyệt đối",
        "Cha mẹ trao đổi với con cái dưới vị thế những người bạn bình đẳng",
        "Bỏ mặc con cái tự do tuyệt đối"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 倡导以平等朋友的姿态与孩子进行日常交流."
    },
    {
      "id": "q2",
      "question_vi": "Cha mẹ nên hành xử thế nào khi có bất đồng lớn với con cái?",
      "options_vi": [
        "Quát mắng và phạt đòn ngay lập tức",
        "Cùng con trao đổi, phân tích rõ ràng mặt lợi và hại thay vì ép buộc",
        "Không nói chuyện trong một tuần"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 不应采取简单粗暴的强制命令，而应与孩子充分讲明利弊."
    },
    {
      "id": "q3",
      "question_vi": "Tác dụng của việc cho con quyền tự chủ lựa chọn thích hợp là gì?",
      "options_vi": [
        "Rèn luyện ý thức gánh vác trách nhiệm và tư duy độc lập",
        "Làm trẻ trở nên kiêu ngạo",
        "Khiến trẻ lười biếng"
      ],
      "answer": 0,
      "explanation_vi": "Trong bài có câu: 能够有效培养他们的责任担当意识与独立思考能力."
    }
  ]
