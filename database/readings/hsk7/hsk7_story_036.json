  "quiz": [
    {
      "id": "q1",
      "question_vi": "Tác động rõ nét của các tuyến đường sắt cao tốc 350km/h đối với đời sống đô thị là gì?",
      "options_vi": [
        "Kéo dài thời gian di chuyển hơn trước",
        "Tạo ra vòng tròn kinh tế một giờ (一小时同城化), giúp đi lại giữa các đô thị tiện lợi như chung một thành phố",
        "Chỉ chở hàng cấm chở khách"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 将相邻核心城市之间的通勤时间压缩至一小时之内，加速要素高频流动."
    },
    {
      "id": "q2",
      "question_vi": "Cơ hội nào mở ra cho các đô thị vừa và nhỏ khi kết nối vào mạng lưới đường sắt cao tốc?",
      "options_vi": [
        "Bị cô lập hoàn toàn khỏi thị trường",
        "Thoát khỏi nguy cơ tụt hậu, bùng nổ du lịch văn hóa và phát triển các ngành sản xuất thế mạnh",
        "Dân cư phải chuyển đi hết"
